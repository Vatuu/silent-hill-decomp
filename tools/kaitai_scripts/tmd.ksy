meta:
  id: tmd
  title: PlayStation Transfer Model Data
  file-extension: tmd
  endian: le
  encoding: ASCII

doc: |
  TMD is the 3D model format used by the Sony PlayStation (PSX) SDK.
  This spec is incompelte and doesn't support lines or sprites.

seq:
  - id: header
    type: header

instances:
  meshes:
    type: mesh
    repeat: expr
    repeat-expr: header.mesh_count

  header_size:
    value: 12

  mesh_size:
    value: 28

types:
  header:
    seq:
      - id: version
        type: u4

      - id: flags
        type: u4

      - id: mesh_count
        type: u4

    instances:
      fixp:
        value: flags & (1 << 0) != 0
        doc: |
          `true` if offsets are absolute from file start, `false` if relative to
          meshes block start.

      meshes_offset:
        value: _root.header_size + (_root.header.mesh_count * _root.mesh_size)

  mesh:
    seq:
      - id: positions_offset
        type: u4

      - id: position_count
        type: u4

      - id: normals_offset
        type: u4

      - id: normal_count
        type: u4

      - id: primitives_offset
        type: u4

      - id: primitive_count
        type: u4

      - id: scale
        type: u4
        doc: scale 0 = x * 1, scale 2 = x * 4, -1 scale = x * (1 / 2), etc.

    instances:
      positions:
        pos: '_root.header.fixp ? positions_offset : (_root.header.meshes_offset + positions_offset)'
        type: svector3
        repeat: expr
        repeat-expr: position_count

      normals:
        pos: '_root.header.fixp ? normals_offset : (_root.header.meshes_offset + normals_offset)'
        type: svector3
        repeat: expr
        repeat-expr: normal_count

      primitives:
        pos: '_root.header.fixp ? primitives_offset : (_root.header.meshes_offset + primitives_offset)'
        type: primitive
        repeat: expr
        repeat-expr: primitive_count

  primitive:
    seq:
      - id: olen
        type: u1
        doc: Word length of primitives generated by intermediate processing.

      - id: ilen
        type: u1
        doc: Word length of packet.

      - id: flags
        type: u1

      - id: mode
        type: u1

      - id: packet
        size: ilen * 4
        type:
          switch-on: primitive_id
          cases:
            primitive_type::polygon: polygon(is_graded,
                                             is_textured,
                                             is_quad,
                                             is_gouraud)
            primitive_type::line:    line
            primitive_type::sprite:  sprite

    instances:
      is_lit:
        value: flags & (1 << 0) != 0
        doc: '`true` if lit, `false` if raw color.'

      is_double_sided:
        value: flags & (1 << 1) != 0
        doc: '`true` if double-sided, `false` if single-sided.'

      is_graded:
        value: flags & (1 << 2) != 0
        doc: 'Untextured only. `true` if graded color, `false` if solid color.'

      is_bright:
        value: mode & (1 << 0) != 0
        doc: '`true` if brightly lit, `false` if textured as-is.'

      is_transparent:
        value: mode & (1 << 1) != 0
        doc: '`true` if semi-transparent, `false` if opaque.'

      is_textured:
        value: mode & (1 << 2) != 0
        doc: '`true` if textured, `false` if untextured.'

      is_quad:
        value: mode & (1 << 3) != 0
        doc: '`true` if quad, `false` if triangle.'

      is_gouraud:
        value: mode & (1 << 4) != 0
        doc: '`true` if gouraud shading, `false` if flat shading.'

      primitive_id:
        value: (mode & 0xE0) >> 5 # Bits 5-7.
        enum: primitive_type

  svector3:
    doc: Q3.12.

    seq:
      - id: x_int
        type: s2

      - id: y_int
        type: s2

      - id: z_int
        type: s2

      - size: 2

    instances:
      x:
        value: x_int.as<f4> / (1 << 12).as<f4>

      y:
        value: y_int.as<f4> / (1 << 12).as<f4>

      z:
        value: z_int.as<f4> / (1 << 12).as<f4>

      length_sqr:
        value: (x * x) + (y * y) + (z * z)

  polygon:
    doc: Solid or graded, textured or untextured, flat or gouraud, triangle or quad.

    params:
      - id: is_graded
        type: bool

      - id: is_textured
        type: bool

      - id: is_quad
        type: bool

      - id: is_gouraud
        type: bool

    seq:
      - id: solid_flat_untextured_triangle
        type: poly_sf3
        if: not is_graded and
            not is_textured and
            not is_quad and
            not is_gouraud

      - id: solid_gouraud_untextured_triangle
        type: poly_sg3
        if: not is_graded and
            not is_textured and
            not is_quad and
            is_gouraud

      - id: graded_gouraud_untextured_triangle
        type: poly_gg3
        if: is_graded and
            not is_textured and
            not is_quad and
            is_gouraud

      - id: graded_flat_untextured_triangle
        type: poly_gf3
        if: is_graded and
            not is_textured and
            not is_quad and
            not is_gouraud

      - id: flat_textured_triangle
        type: poly_ft3
        if: is_textured and
            not is_quad and
            not is_gouraud

      - id: gouraud_textured_triangle
        type: poly_gt3
        if: is_textured and
            not is_quad and
            is_gouraud

      - id: solid_flat_untextured_quad
        type: poly_sf4
        if: not is_graded and
            not is_textured and
            is_quad and
            not is_gouraud

      - id: solid_gouraud_untextured_quad
        type: poly_sg4
        if: not is_graded and
            not is_textured and
            is_quad and
            is_gouraud

      - id: graded_flat_untextured_quad
        type: poly_gf4
        if: is_graded and
            not is_textured and
            is_quad and
            not is_gouraud

      - id: graded_gouraud_untextured_quad
        type: poly_gg4
        if: is_graded and
            not is_textured and
            is_quad and
            is_gouraud

      - id: flat_textured_quad
        type: poly_ft4
        if: is_textured and
            is_quad and
            not is_gouraud

      - id: gouraud_textured_quad
        type: poly_gt4
        if: is_textured and
            is_quad and
            is_gouraud

  line:
    doc: Unsupported.

  sprite:
    doc: Unsupported.

  poly_sf3:
    doc: Solid flat untextured triangle.

    seq:
      - id: color
        type: color

      - id: normal_idx
        type: u2

      - id: position_idx_0
        type: u2

      - id: position_idx_1
        type: u2

      - id: position_idx_2
        type: u2

  poly_sg3:
    doc: Solid gouraud untextured triangle.

    seq:
      - id: color
        type: color

      - id: normal_idx_0
        type: u2

      - id: position_idx_0
        type: u2

      - id: normal_idx_1
        type: u2

      - id: position_idx_1
        type: u2

      - id: normal_idx_2
        type: u2

      - id: position_idx_2
        type: u2

  poly_gf3:
    doc: Graded flat untextured triangle.

    seq:
      - id: color_0
        type: color

      - id: color_1
        type: color

      - id: color_2
        type: color

      - id: normal_idx
        type: u2

      - id: position_idx_0
        type: u2

      - id: position_idx_1
        type: u2

      - id: position_idx_2
        type: u2

  poly_gg3:
    doc: Graded gouraud untextured triangle.

    seq:
      - id: color_0
        type: color

      - id: color_1
        type: color

      - id: color_2
        type: color

      - id: normal_idx_0
        type: u2

      - id: position_idx_0
        type: u2

      - id: normal_idx_1
        type: u2

      - id: position_idx_1
        type: u2

      - id: normal_idx_2
        type: u2

      - id: position_idx_2
        type: u2

  poly_ft3:
    doc: Flat textured triangle.

    seq:
      - id: u_0
        type: u1

      - id: v_0
        type: u1

      - id: cba
        type: cba

      - id: u_1
        type: u1

      - id: v_1
        type: u1

      - id: tsb
        type: tsb

      - id: u_2
        type: u1

      - id: v_2
        type: u1

      - size: 2

      - id: normal_idx
        type: u2

      - id: position_idx_0
        type: u2

      - id: position_idx_1
        type: u2

      - id: position_idx_2
        type: u2

  poly_gt3:
    doc: Gouraud textured triangle.

    seq:
      - id: u_0
        type: u1

      - id: v_0
        type: u1

      - id: cba
        type: cba

      - id: u_1
        type: u1

      - id: v_1
        type: u1

      - id: tsb
        type: tsb

      - id: u_2
        type: u1

      - id: v_2
        type: u1

      - size: 2

      - id: normal_idx_0
        type: u2

      - id: position_idx_0
        type: u2

      - id: normal_idx_1
        type: u2

      - id: position_idx_1
        type: u2

      - id: normal_idx_2
        type: u2

      - id: position_idx_2
        type: u2

  poly_sf4:
    doc: Solid flat untextured quad.

    seq:
      - id: color
        type: color

      - id: normal_idx
        type: u2

      - id: position_idx_0
        type: u2

      - id: position_idx_1
        type: u2

      - id: position_idx_2
        type: u2

      - id: position_idx_3
        type: u2

      - size: 2

  poly_gf4:
    doc: Graded flat untextured quad.

    seq:
      - id: color_0
        type: color

      - id: color_1
        type: color

      - id: color_2
        type: color

      - id: color_3
        type: color

      - id: normal_idx
        type: u2

      - id: position_idx_0
        type: u2

      - id: position_idx_1
        type: u2

      - id: position_idx_2
        type: u2

      - id: position_idx_3
        type: u2

      - size: 2

  poly_sg4:
    doc: Solid gouraud untextured quad.

    seq:
      - id: color
        type: color

      - id: normal_idx_0
        type: u2

      - id: vertex_idx_0
        type: u2

      - id: normal_idx_1
        type: u2

      - id: vertex_idx_1
        type: u2

      - id: normal_idx_2
        type: u2

      - id: vertex_idx_2
        type: u2

      - id: normal_idx_3
        type: u2

      - id: vertex_idx_3
        type: u2

  poly_gg4:
    doc: Graded gouraud untextured quad.

    seq:
      - id: color_0
        type: color

      - id: color_1
        type: color

      - id: color_2
        type: color

      - id: color_3
        type: color

      - id: normal_idx_0
        type: u2

      - id: vertex_idx_0
        type: u2

      - id: normal_idx_1
        type: u2

      - id: vertex_idx_1
        type: u2

      - id: normal_idx_2
        type: u2

      - id: vertex_idx_2
        type: u2

      - id: normal_idx_3
        type: u2

      - id: vertex_idx_3
        type: u2

  poly_ft4:
    doc: Flat textured quad.

    seq:
      - id: u_0
        type: u1

      - id: v_0
        type: u1

      - id: cba
        type: cba

      - id: u_1
        type: u1

      - id: v_1
        type: u1

      - id: tsb
        type: tsb

      - id: u_2
        type: u1

      - id: v_2
        type: u1

      - size: 2

      - id: u_3
        type: u1

      - id: v_3
        type: u1

      - size: 2

      - id: normal_idx
        type: u2

      - id: position_idx_0
        type: u2

      - id: position_idx_1
        type: u2

      - id: position_idx_2
        type: u2

      - id: position_idx_3
        type: u2

      - size: 2

  poly_gt4:
    doc: Gouraud textured quad.

    seq:
      - id: u_0
        type: u1

      - id: v_0
        type: u1

      - id: cba
        type: cba

      - id: u_1
        type: u1

      - id: v_1
        type: u1

      - id: tsb
        type: tsb

      - id: u_2
        type: u1

      - id: v_2
        type: u1

      - size: 2

      - id: u_3
        type: u1

      - id: v_3
        type: u1

      - size: 2

      - id: normal_idx_0
        type: u2

      - id: vertex_idx_0
        type: u2

      - id: normal_idx_1
        type: u2

      - id: vertex_idx_1
        type: u2

      - id: normal_idx_2
        type: u2

      - id: vertex_idx_2
        type: u2

      - id: normal_idx_3
        type: u2

      - id: vertex_idx_3
        type: u2

  color:
    doc: Packed RGB color.

    seq:
      - id: rgb
        type: u4

    instances:
      r:
        value: rgb & 0xFF

      g:
        value: (rgb >> 8) & 0xFF

      b:
        value: (rgb >> 16) & 0xFF

  tsb:
    doc: Texture or sprite pattern info.

    seq:
      - id: bitfield
        type: u2

    instances:
      t_page:
        value: bitfield & 0x1F # Bits 0-4.
        doc: Texture page index (0-31) in VRAM.

      blend_mode:
        value: (bitfield & 0x60) >> 5 # Bits 5-6.
        enum: blend_mode

      color_mode:
        value: (bitfield & 0x180) >> 7 # Bits 7-8.
        enum: color_mode

  cba:
    doc: CLUT position in VRAM.

    seq:
      - id: bitfield
        type: u2

    instances:
      x:
        value: bitfield & 0x3F # Bits 0-5.

      y:
        value: (bitfield & 0x7FC0) >> 6 # Bits 6-14.

enums:
  primitive_type:
    1: polygon
    2: line
    3: sprite

  blend_mode:
    0: alpha_half
    1: add
    2: subtract
    3: add_quarter

  color_mode:
    0: bit_4
    1: bit_8
    2: bit_15
