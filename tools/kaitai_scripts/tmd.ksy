meta:
  id: tmd
  title: PlayStation Transfer Model Data
  file-extension: tmd
  endian: le
  encoding: ASCII

doc: |
  TMD is the 3D model format used by the Sony PlayStation (PSX) SDK.
  This spec is incompelte and doesn't support lines or sprites.

seq:
  - id: header
    type: header

instances:
  meshes:
    type: mesh
    repeat: expr
    repeat-expr: header.mesh_count

types:
  header:
    seq:
      - id: version
        type: u4

      - id: flags
        type: u4

      - id: mesh_count
        type: u4

    instances:
      fixp:
        value: flags & (1 << 0) != 0
        doc: |
          `true` if offsets are absolute from file start, `false` if relative to
          meshes block start.

      meshes_offset:
        value: 12 + (_root.header.mesh_count * 28)
        doc: '[`header` size] + (_root.header.mesh_count * [`mesh` size])'

  mesh:
    seq:
      - id: positions_offset
        type: u4

      - id: position_count
        type: u4

      - id: normals_offset
        type: u4

      - id: normal_count
        type: u4

      - id: primitives_offset
        type: u4

      - id: primitive_count
        type: u4

      - id: scale
        type: u4
        doc: scale 0 = x * 1, scale 2 = x * 4, -1 = scale x * (1 / 2), etc.

    instances:
      positions:
        pos: '_root.header.fixp ? positions_offset : (_root.header.meshes_offset + positions_offset)'
        type: svector3
        repeat: expr
        repeat-expr: position_count

      normals:
        pos: '_root.header.fixp ? normals_offset : (_root.header.meshes_offset + normals_offset)'
        type: svector3
        repeat: expr
        repeat-expr: normal_count

      primitives:
        pos: '_root.header.fixp ? primitives_offset : (_root.header.meshes_offset + primitives_offset)'
        type: primitive
        repeat: expr
        repeat-expr: primitive_count

  primitive:
    seq:
      - id: olen
        type: u1
        doc: Word length of primitives generated by intermediate processing.

      - id: ilen
        type: u1
        doc: Word length of packet.

      - id: flag
        type: u1

      - id: mode
        type: u1

      - id: packet
        size: ilen * 4
        type:
          switch-on: primitive_id
          cases:
            primitive_type::polygon: polygon(is_textured, is_quad, is_gouraud)
            primitive_type::line: line
            primitive_type::sprite: sprite

    instances:
      is_lit:
        value: mode & (1 << 0) != 0
        doc: '`true` if lit, `false` if textured as-is.'

      is_transparent:
        value: mode & (1 << 1) != 0
        doc: '`true` if semi-transparent, `false` if opaque.'

      is_textured:
        value: mode & (1 << 2) != 0
        doc: '`true` if textured, `false` if untextured.'

      is_quad:
        value: mode & (1 << 3) != 0
        doc: '`true` if quad, `false` if triangle.'

      is_gouraud:
        value: mode & (1 << 4) != 0
        doc: '`true` if gouraud shading, `false` if flat shading.'

      primitive_id:
        value: (mode & ((1 << 5) | (1 << 6) | (1 << 7))) >> 5
        enum: primitive_type

  svector3:
    doc: Q3.12.

    seq:
      - id: x_int
        type: s2

      - id: y_int
        type: s2

      - id: z_int
        type: s2

      - size: 2

    instances:
      x:
        value: x_int.as<f4> / (1 << 12).as<f4>

      y:
        value: y_int.as<f4> / (1 << 12).as<f4>

      z:
        value: z_int.as<f4> / (1 << 12).as<f4>

      length_sqr:
        value: (x * x) + (y * y) + (z * z)

  polygon:
    doc: Textured or untextured, flat or gouraud, triangle or quad.

    params:
      - id: is_textured
        type: bool

      - id: is_quad
        type: bool

      - id: is_gouraud
        type: bool

    seq:
      - id: flat_textured_triangle
        type: poly_ft3
        if: is_textured and not is_quad and not is_gouraud

      - id: flat_untextured_triangle
        type: poly_ft3
        if: not is_textured and not is_quad and not is_gouraud

      - id: flat_textured_quad
        type: poly_ft3
        if: is_textured and is_quad and not is_gouraud

      - id: flat_untextured_quad
        type: poly_ft3
        if: not is_textured and is_quad and not is_gouraud

      - id: gouraud_textured_triangle
        type: poly_ft3
        if: is_textured and not is_quad and is_gouraud

      - id: gouraud_untextured_triangle
        type: poly_ft3
        if: not is_textured and not is_quad and is_gouraud

      - id: gouraud_textured_quad
        type: poly_ft3
        if: is_textured and is_quad and is_gouraud

      - id: gouraud_untextured_quad
        type: poly_ft3
        if: not is_textured and is_quad and is_gouraud

  line:
    doc: TODO Unsupported.

  sprite:
    doc: TODO Unsupported.

  poly_f3:
    doc: Flat untextured triangle.

    seq:
      - id: color
        type: u4

      - id: position_idx_0
        type: u2

      - id: position_idx_1
        type: u2

      - id: position_idx_2
        type: u2

      - id: normal_idx
        type: u2

  poly_ft3:
    doc: Flat textured triangle.

    seq:
      - id: u_0
        type: u1

      - id: v_0
        type: u1

      - id: cba
        type: cba

      - id: u_1
        type: u1

      - id: v_1
        type: u1

      - id: tsb
        type: tsb

      - id: u_2
        type: u1

      - id: v_2
        type: u1

      - size: 2

      - id: position_idx_0
        type: u2

      - id: position_idx_1
        type: u2

      - id: position_idx_2
        type: u2

      - id: normal_idx
        type: u2

  poly_f4:
    doc: Flat untextured quad.

    seq:
      - id: color
        type: u4

      - id: v0
        type: u2

      - id: v1
        type: u2

      - id: v2
        type: u2

      - id: v3
        type: u2

      - id: n0
        type: u2

      - size: 2

  poly_ft4:
    doc: Flat textured quad.

    seq:
      - id: u_0
        type: u1

      - id: v_0
        type: u1

      - id: cba
        type: cba

      - id: u_1
        type: u1

      - id: v_1
        type: u1

      - id: tsb
        type: tsb

      - id: u_2
        type: u1

      - id: v_2
        type: u1

      - size: 2

      - id: u_3
        type: u1

      - id: v_3
        type: u1

      - size: 2

      - id: position_idx_0
        type: u2

      - id: position_idx_1
        type: u2

      - id: position_idx_2
        type: u2

      - id: position_idx_3
        type: u2

      - id: normal_idx
        type: u2

      - size: 2

  poly_g3:
    doc: Gouraud untextured triangle.

    seq:
      - id: color_0
        type: u4

      - id: position_idx_0
        type: u2

      - id: position_idx_1
        type: u2

      - id: position_idx_2
        type: u2

      - id: normal_idx_0
        type: u2

      - id: color_1
        type: u4

      - id: normal_idx_1
        type: u2

      - id: normal_idx_2
        type: u2

      - id: color_2
        type: u4

  poly_gt3:
    doc: Gouraud textured triangle.

    seq:
      - id: u_0
        type: u1

      - id: v_0
        type: u1

      - id: cba
        type: cba

      - id: u_1
        type: u1

      - id: v_1
        type: u1

      - id: tsb
        type: tsb

      - id: u_2
        type: u1

      - id: v_2
        type: u1

      - size: 2

      - id: color_0
        type: u4

      - id: vertex_idx_0
        type: u2

      - id: vertex_idx_1
        type: u2

      - id: vertex_idx_2
        type: u2

      - id: normal_idx_0
        type: u2

      - id: color_1
        type: u4

      - id: normal_idx_1
        type: u2

      - id: normal_idx_2
        type: u2

      - id: color_2
        type: u4

  poly_g4:
    doc: Gouraud untextured quad.

    seq:
      - id: color_0
        type: u4

      - id: vertex_idx_0
        type: u2

      - id: vertex_idx_1
        type: u2

      - id: vertex_idx_2
        type: u2

      - id: vertex_idx_3
        type: u2

      - id: normal_idx_0
        type: u2

      - size: 2

      - id: color_1
        type: u4

      - id: normal_idx_1
        type: u2

      - id: normal_idx_2
        type: u2

      - id: color_2
        type: u4

      - id: normal_idx_3
        type: u2

      - size: 2

      - id: color_3
        type: u4

  poly_gt4:
    doc: Gouraud textured quad.

    seq:
      - id: u_0
        type: u1

      - id: v_0
        type: u1

      - id: cba
        type: cba

      - id: u_1
        type: u1

      - id: v_1
        type: u1

      - id: tsb
        type: tsb

      - id: u_2
        type: u1

      - id: v_2
        type: u1

      - size: 2

      - id: u_3
        type: u1

      - id: v_3
        type: u1

      - size: 2

      - id: color_0
        type: u4
        doc: TODO Were there more? Made a bad copy.

  tsb:
    doc: Texture or sprite pattern info.

    seq:
      - id: bitfield
        type: u2

    instances:
      t_page:
        value: bitfield & ((1 << 0) | (1 << 2) | (1 << 3) | (1 << 4))
        doc: Index 0-31.

      blend_mode:
        value: (bitfield & ((1 << 5) | (1 << 6))) >> 5
        enum: blend_mode

      color_mode:
        value: (bitfield & ((1 << 7) | (1 << 8))) >> 7
        enum: color_mode

  cba:
    doc: Indicates the position where the CLUT is stored in VRAM.

    seq:
      - id: bitfield
        type: u2

    instances:
      cbx:
        value: bitfield & ((1 << 0) | (1 << 2) | (1 << 3) | (1 << 4) | (1 << 5))
        doc: Upper six bits of 10 bits of X coordinate value for CLUT on VRAM.

      cby:
        value: (bitfield & ((1 << 6) | (1 << 7) | (1 << 8) | (1 << 9) | (1 << 10) | (1 << 11) | (1 << 12) | (1 << 13) | (1 << 14))) >> 6
        doc: Nine bits of Y coordinate value for CLUT on VRAM.

enums:
  primitive_type:
    1: polygon
    2: line
    3: sprite

  blend_mode:
    0: alpha_half
    1: add
    2: subtract
    3: add_quarter

  color_mode:
    0: bit_4
    1: bit_8
    2: bit_15
